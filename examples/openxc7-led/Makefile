FAMILY  = kintex7
PART    = xc7k160tffg676-1
PROJECT = led

# openFPGALoader has no board profile for this board; specify the cable directly
JTAG_LINK = -c ft232 --fpga-part xc7k160tffg676

# chipdb generation (first build only) works with plain python3 if pypy3 is absent
PYPY3 = python3

# openXC7.mk: copy from https://github.com/openXC7/demo-projects
include openXC7.mk
