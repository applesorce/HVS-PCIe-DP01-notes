# K7-160T-DP: MicroBlaze + MIG DDR3 top-level constraints.
# DDR3 pin/IOSTANDARD constraints are generated by the MIG wizard itself into a
# separate .xdc alongside the mig_7series_0 IP core -- do not duplicate them here.

# 50MHz single-ended board oscillator, SRCC clock-capable pin (confirmed via
# prjxray-db package_pins.csv: D24 = IO_L11N_T1_SRCC_14). Used by every
# previous design on this board (LED test, LiteX BIOS console, etc).
set_property PACKAGE_PIN D24 [get_ports sys_clk]
set_property IOSTANDARD LVCMOS33 [get_ports sys_clk]
create_clock -name sys_clk -period 20.0 [get_ports sys_clk]
# D24 is IO_L11N_T1_SRCC_14 -- the N-side of an SRCC differential pair (confirmed
# via prjxray-db). Vivado's placer DRC (PLIO-9) refuses to LOC a single-ended
# clock source to an N-type CCIO by default. The P-side (D23, IO_L11P_T1_SRCC_14)
# is not wired to the oscillator on this board (only D24 is, confirmed by every
# prior design). At 50MHz, routing the clock via general fabric instead of the
# dedicated clock spine is electrically fine, so relax the dedicated-route
# requirement instead of trying to move the oscillator to a different pin.
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets -of_objects [get_ports sys_clk]]

# UART console, reusing the exact same external USB-serial wiring as every
# previous design on this board (TP3=TX/V23, TP4=RX/U22).
set_property PACKAGE_PIN V23 [get_ports uart_txd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_txd]
set_property PACKAGE_PIN U22 [get_ports uart_rxd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_rxd]

# DDR3 calibration status LED (C21, physical LED "D5", real-hw confirmed).
set_property PACKAGE_PIN C21 [get_ports init_calib_led]
set_property IOSTANDARD LVCMOS33 [get_ports init_calib_led]
